{
  "name": "regx-platform",
  "version": "1.0.0",
  "private": true,
  "description": "REG-X ERP/POS SaaS Enterprise — Monorepo",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev":           "npm run dev --workspace=frontend",
    "dev:frontend":  "npm run dev --workspace=frontend",
    "build":         "npm run build --workspace=frontend",
    "build:frontend":"npm run build --workspace=frontend",
    "install:all":   "npm install && npm install --workspace=frontend",
    "lint":          "npm run lint --workspace=frontend",
    "test":          "npm run test --workspace=frontend",
    "clean":         "rimraf frontend/dist frontend/node_modules node_modules",
    "db:migrate":    "node scripts/migrate.js",
    "db:seed":       "node scripts/seed.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
